      <bpmn:outgoing>Flow_0kcv3td</bpmn:outgoing>
      <bpmn:outgoing>Flow_178ahml</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1bufmam" name="Case closed: no lookup">
      <bpmn:incoming>Flow_0kcv3td</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_1ap4269" name="Run paid address lookup immediately">
      <bpmn:incoming>Flow_178ahml</bpmn:incoming>
      <bpmn:outgoing>Flow_0anzlxf</bpmn:outgoing>
    </bpmn:task>
