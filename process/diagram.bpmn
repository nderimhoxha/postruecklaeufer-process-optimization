    <bpmn:startEvent id="StartEvent_0ktcp9i" name="Mail arrives" />
    <bpmn:task id="Activity_1sgon4k" name="Take letter from box of returned mail">
      <bpmn:outgoing>Flow_14bxuow</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_11vie0o" name="Eligible?">
