  <bpmn:collaboration id="Collaboration_0v7jxha">
    <bpmn:participant id="Participant_1j5dc44" name="Returned mail: current process (AS-IS)" processRef="Process_0lsrd6x" />
    <bpmn:textAnnotation id="TextAnnotation_086yysq">
      <bpmn:text>checks: current account, legal age, address still invalid</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ibvod9">
      <bpmn:text>No central tracking: results only in individual client account notes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0jno9lm">
      <bpmn:text>No link to the returned mail team: a client may have already sent his new address, but the paid lookup runs anyway (duplicate work, fee refunds)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_14fatwc" associationDirection="None" sourceRef="Gateway_11vie0o" targetRef="TextAnnotation_086yysq" />
    <bpmn:association id="Association_1qsbcol" associationDirection="None" sourceRef="Activity_10ayfi3" targetRef="TextAnnotation_1ibvod9" />
    <bpmn:association id="Association_02ufe7j" associationDirection="None" sourceRef="Activity_09ub500" targetRef="TextAnnotation_0jno9lm" />
  </bpmn:collaboration>
